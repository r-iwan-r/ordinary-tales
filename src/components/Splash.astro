---
import { Image } from 'astro:assets';
import logoImage from '../assets/imgs/OT_Mark_White.png';
---

<div id="Splash">
	<div class="Content_Logo">
		<Image src={logoImage} alt="Ordinary Tales Logo" width={287} quality="high" />
	</div>
	<div class="Text_Group">
		<div class="Text_Main">Ordinary tales</div>
		<div class="Text_Sub">website.</div>
	</div>
</div>

<style>

#Splash {
	/* 画面の最前面に固定して動かないようにする */
	position: fixed;
	/* 左上の角を基準点にする */
	top: 0;
	left: 0;
	/* 画面全体（横幅・高さ100%）を覆う */
	width: 100%;
	height: 100vh;
	/* 背景を黒にする */
	background: #000;
	/* レイアウトをフレックスボックス（自由な配置）にする */
	display: flex;
	/* 中身の要素（ロゴとテキスト）を「横」に並べる */
	flex-direction: row; 
	/* 横方向の「中央」に寄せる */
	justify-content: center;
	/* 縦方向の「中央」に寄せる */
	align-items: center;
	/* ロゴとテキストの間の距離を40pxあける */
	gap: 40px;
	/* 他の要素より上に重なるように優先度を最大級にする */
	z-index: 9999;
	/* 透明度（opacity）が変化する時、1秒かけてじわっと動かす */
	/* transitionをopacityに絞って安定させます */
	transition: opacity 1s ease-out;
	/* スクロール禁止をCSS側でも念のため指定 */
	overflow: hidden;
}

.Content_Logo {
	animation: Fade_In_Out 4s ease-in-out forwards;
}

.Text_Group {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.Text_Main {
	font-size: 4rem;
	font-weight: bold;
	letter-spacing: 0.15rem;
	color: #fff;
	white-space: nowrap;
	line-height: 1.1;
	animation: Fade_In_Out 4s ease-in-out forwards;
}

.Text_Sub {
	font-size: 2rem;
	letter-spacing: 0.1rem; 
	color: #fff;
	margin-top: 25px;
	white-space: nowrap;
	animation: Fade_In_Out_Sub_Text 4s ease-in-out forwards;
}

@keyframes Fade_In_Out {
	0% { opacity: 0; transform: scale(0.95); }
	30%, 70% { opacity: 1; transform: scale(1); }
	100% { opacity: 0; transform: scale(1.1); }
}

@keyframes Fade_In_Out_Sub_Text {
	0%, 25% { opacity: 0; transform: scale(0.95); }
	50% { opacity: 1; transform: scale(1); }
	70% { opacity: 1; transform: scale(1); }
	100% { opacity: 0; transform: scale(1.1); }
}

/* --- スマホ・タブレット用の調整（1200px以下） --- */
@media screen and (max-width: 1200px) {
  #Splash {
    flex-direction: column; /* ロゴとテキストを縦並びに変える */
    gap: 20px; /* 縦並びにした時の間隔を少し狭くする */
    padding: 20px; /* 画面端に当たらないよう余白を作る */
  }

  .Content_Logo img {
    width: 40vw !important; /* ロゴの幅を画面幅の40%に縮める */
    height: auto !important; /* 縦横比を維持する */
  }

  .Text_Main {
    font-size: 2rem; /* メイン文字をスマホ向けに小さくする */
    letter-spacing: 0.1rem; /* 文字間隔を少し詰める */
  }

  .Text_Sub {
    font-size: 1rem; /* サブ文字もスマホ向けに小さくする */
    margin-top: 10px; /* 文字間の隙間を調整する */
  }
}

</style>

<script is:inline>
	// 予約型タイマーで確実に実行
	(function() {
		// 100ミリ秒だけ待ってから要素を掴む（確実性を高めるため）
		setTimeout(() => {
			const intro = document.getElementById('Splash');
			const main = document.getElementById('Content_Main');

			if (!intro) return;

			// アニメーションに合わせて4秒（4000ms）待機
			setTimeout(() => {
				intro.style.opacity = '0';
				
				// フェードアウト完了後に完全に消去
				setTimeout(() => {
					intro.style.display = 'none';
					if (main) {
						main.style.opacity = '1'; // メインを表示
					}
					document.body.style.overflow = 'auto'; // スクロール許可
				}, 100);
			}, 4000);
		}, 100);
	})();
</script>